# Copy to .env and fill in real values. .env is gitignored; never commit it.

NODE_ENV=development
PORT=3000

# Used by Docker Compose to create the database and to build the app's DATABASE_URL.
# Keep the password URL-safe (letters, digits, - _ .) because it is embedded in a URL.
POSTGRES_USER=payments
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payments
POSTGRES_PORT=5432

# Used when running the app or migrations directly on your machine (npm run dev / migrate:up).
# Inside Docker Compose this is overridden to point at the "db" service.
DATABASE_URL=postgres://payments:change-me@localhost:5432/payments
